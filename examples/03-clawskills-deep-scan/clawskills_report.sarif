{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "agent-audit",
          "version": "0.18.2",
          "informationUri": "https://github.com/anthropics/agent-audit",
          "organization": "Agent Security Suite",
          "rules": [
            {
              "id": "AGENT-034",
              "name": "Tool Function Without Input Validation",
              "shortDescription": {
                "text": "Tool Function Without Input Validation"
              },
              "fullDescription": {
                "text": "A tool function accepts string or Any parameters without performing input validation in the function body. This enables tool misuse where attackers can pass malicious inputs to trigger unauthorized actions.\n"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-02",
                "tags": [
                  "external/cwe/cwe-20",
                  "OWASP-Agentic-ASI-02",
                  "tool_misuse"
                ]
              },
              "help": {
                "text": "Add input validation at the start of tool functions. Use isinstance() checks, regex validation, or pydantic Field constraints to ensure inputs are safe before processing.\n",
                "markdown": "Add input validation at the start of tool functions. Use isinstance() checks, regex validation, or pydantic Field constraints to ensure inputs are safe before processing.\n"
              }
            },
            {
              "id": "AGENT-047",
              "name": "Subprocess Execution Without Sandbox",
              "shortDescription": {
                "text": "Subprocess Execution Without Sandbox"
              },
              "fullDescription": {
                "text": "Agent executes subprocess (subprocess.check_output) without sandbox isolation. Subprocess execution with dynamic input can lead to command injection."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "owasp-agentic-id": "ASI-02",
                "tags": [
                  "external/cwe/cwe-78",
                  "OWASP-Agentic-ASI-02",
                  "tool_misuse"
                ]
              },
              "help": {
                "text": "Avoid shell=True. Use parameterized commands with shlex.quote(). Consider sandboxing subprocess execution with containers or restricted shells.",
                "markdown": "Avoid shell=True. Use parameterized commands with shlex.quote(). Consider sandboxing subprocess execution with containers or restricted shells."
              }
            },
            {
              "id": "AGENT-004",
              "name": "Hardcoded Credentials",
              "shortDescription": {
                "text": "Hardcoded Credentials"
              },
              "fullDescription": {
                "text": "Found Generic Secret/Password"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-04",
                "tags": [
                  "external/cwe/cwe-798",
                  "OWASP-Agentic-ASI-04",
                  "credential_exposure"
                ]
              },
              "help": {
                "text": "Use environment variables or a secrets manager",
                "markdown": "Use environment variables or a secrets manager"
              }
            },
            {
              "id": "AGENT-043",
              "name": "Daemon Privilege Escalation",
              "shortDescription": {
                "text": "Daemon Privilege Escalation"
              },
              "fullDescription": {
                "text": "Agent registers as system daemon/service, gaining persistent elevated privileges. Daemon processes often run with elevated permissions and can survive user logout."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-03",
                "tags": [
                  "external/cwe/cwe-250",
                  "OWASP-Agentic-ASI-03",
                  "identity_privilege_abuse"
                ]
              },
              "help": {
                "text": "Run agents with minimal required privileges using dedicated service accounts. Implement proper privilege separation.",
                "markdown": "Run agents with minimal required privileges using dedicated service accounts. Implement proper privilege separation."
              }
            },
            {
              "id": "AGENT-044",
              "name": "Sudoers NOPASSWD Configuration",
              "shortDescription": {
                "text": "Sudoers NOPASSWD Configuration"
              },
              "fullDescription": {
                "text": "Configures or guides NOPASSWD sudoers entry. This allows password-less sudo access which can be exploited if the agent is compromised."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-03",
                "tags": [
                  "external/cwe/cwe-269",
                  "OWASP-Agentic-ASI-03",
                  "identity_privilege_abuse"
                ]
              },
              "help": {
                "text": "Avoid NOPASSWD sudoers entries. Use targeted sudo rules with specific commands instead of ALL.",
                "markdown": "Avoid NOPASSWD sudoers entries. Use targeted sudo rules with specific commands instead of ALL."
              }
            },
            {
              "id": "AGENT-048",
              "name": "Extension Permission Boundary Violation",
              "shortDescription": {
                "text": "Extension Permission Boundary Violation"
              },
              "fullDescription": {
                "text": "Extension/plugin directly imports from core modules without permission boundaries. Extensions should use defined APIs rather than direct imports to maintain security isolation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-04",
                "tags": [
                  "external/cwe/cwe-863",
                  "OWASP-Agentic-ASI-04",
                  "supply_chain_agentic"
                ]
              },
              "help": {
                "text": "Implement permission manifest for extensions. Use defined extension APIs instead of direct imports. Sandbox extension execution.",
                "markdown": "Implement permission manifest for extensions. Use defined extension APIs instead of direct imports. Sandbox extension execution."
              }
            },
            {
              "id": "AGENT-045",
              "name": "Browser Automation Without Sandbox",
              "shortDescription": {
                "text": "Browser Automation Without Sandbox"
              },
              "fullDescription": {
                "text": "Browser automation without sandbox restrictions. page.evaluate() and similar APIs can execute arbitrary JavaScript in the browser context, potentially leading to credential theft or DOM manipulation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-02",
                "tags": [
                  "external/cwe/cwe-94",
                  "OWASP-Agentic-ASI-02",
                  "tool_misuse"
                ]
              },
              "help": {
                "text": "Enable browser sandbox (remove --no-sandbox flag). Avoid page.evaluate() with untrusted input. Use browser automation with minimal permissions.",
                "markdown": "Enable browser sandbox (remove --no-sandbox flag). Avoid page.evaluate() with untrusted input. Use browser automation with minimal permissions."
              }
            },
            {
              "id": "AGENT-046",
              "name": "System Credential Store Access",
              "shortDescription": {
                "text": "System Credential Store Access"
              },
              "fullDescription": {
                "text": "Agent accesses system credential store (macOS Keychain). This grants access to sensitive credentials that may be used for privilege escalation or lateral movement."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-05",
                "tags": [
                  "external/cwe/cwe-522",
                  "OWASP-Agentic-ASI-05",
                  "unexpected_code_execution"
                ]
              },
              "help": {
                "text": "Minimize credential store access. Use dedicated secrets management with proper access controls. Log all credential access attempts.",
                "markdown": "Minimize credential store access. Use dedicated secrets management with proper access controls. Log all credential access attempts."
              }
            },
            {
              "id": "AGENT-059",
              "name": "Skill Critical File Modification",
              "shortDescription": {
                "text": "Skill Critical File Modification"
              },
              "fullDescription": {
                "text": "Critical file modification detected: instruction to modify critical identity file"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "owasp-agentic-id": "ASI-01",
                "tags": [
                  "OWASP-Agentic-ASI-01",
                  "goal_hijack"
                ]
              },
              "help": {
                "text": "Review skill instructions in 'SKILL.md'",
                "markdown": "Review skill instructions in 'SKILL.md'"
              }
            },
            {
              "id": "AGENT-058",
              "name": "Skill Obfuscated Shell",
              "shortDescription": {
                "text": "Skill Obfuscated Shell"
              },
              "fullDescription": {
                "text": "Obfuscated shell command detected: curl output piped to shell interpreter"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.8",
                "owasp-agentic-id": "ASI-04",
                "tags": [
                  "OWASP-Agentic-ASI-04",
                  "supply_chain_agentic"
                ]
              },
              "help": {
                "text": "Review skill instructions in 'SKILL.md'",
                "markdown": "Review skill instructions in 'SKILL.md'"
              }
            }
          ]
        }
      },
